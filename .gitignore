# Local variable overrides — never commit real values
terraform/terraform.tfvars

# Terraform working directory
terraform/.terraform/

# Terraform state files — managed remotely in S3
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.tfstate

# Plan files — contain sensitive data
terraform/*.tfplan
terraform/tfplan

# Crash logs
terraform/crash.log

# Override files
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json
